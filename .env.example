# === Supabase ===
# Récupérés dans Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# === Chiffrement des clés API BYOK (utilisé à partir de J6) ===
# Clé secrète 32 bytes en base64 pour chiffrer les clés API des providers IA au repos.
# Générer avec : openssl rand -base64 32
BYOK_ENCRYPTION_KEY=
